<script>
document.addEventListener('DOMContentLoaded', function () {
  var bar = document.querySelector('.menu-bar .right-buttons');
  if (!bar) return;
  var a = document.createElement('a');
  a.href = window.location.pathname.replace(/^\/en\//, '/ko/');
  a.title = '한국어';
  a.setAttribute('hreflang', 'ko');
  a.setAttribute('aria-label', '한국어로 보기');
  a.style.cssText = 'margin-left:.5rem;font-size:.85rem;text-decoration:none;';
  a.textContent = 'KO';
  bar.appendChild(a);
});
</script>
